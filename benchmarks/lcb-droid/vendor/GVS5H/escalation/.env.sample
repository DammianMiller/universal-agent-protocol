# Copy to escalation/.env and fill in. Sourced by run_bench_script/*.sh
#
#   cp escalation/.env.sample escalation/.env && chmod 600 escalation/.env

# ---- run_q38_fn_5pass.sh ----------------------
LITELLM_KEY=
LITELLM_HOST=                       # host:port of the litellm proxy
# Optional
#MODEL_ALIAS=large-model
#PAR=48                             # problems solved concurrently

# ---- run_ds_v41_f_5pass.sh --------------------
DEEPSEEK_API=
# Optional
#DS_MODEL=deepseek-flash
#PAR=32

# ---- shared knobs -----------------------------
#CAP=128000                         # max output tokens per model call
#ENGINES="single multiagent"        # which v2 engines to run
#PASSES="1 2 3 4 5"                 # which passes to run
#INFRA_RETRIES=3                    # re-runs of a pass that ends with infra records
#MULTIAGENT_MAX_ITERS=10            # manager engine: worker iterations per problem
#MULTIAGENT_MAX_TASKS=12            # manager engine: live task list cap
#HF_HOME=~/.cache/huggingface       # LiveCodeBench dataset cache
#FG=1                               # run in the foreground instead of detaching
