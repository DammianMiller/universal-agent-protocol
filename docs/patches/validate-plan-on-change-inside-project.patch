+        cleared.extend(
+            {"key": k, "reason": "outside the project directory", "at": int(time.time())}
+            for k in dropped
+        )
+        state["cleared"] = cleared[-50:]
+        _save_state(state)
+    pending = list(kept.keys())
     if pending:
