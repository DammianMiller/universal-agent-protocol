.codex/config.toml

# Per-platform hook copies — install output, not source.
#
# `uap hooks install` materializes these from templates/hooks/ for every
# platform it supports. Tracking the copies as well meant the same script lived
# in six places, and the copies drifted from their template: the committed
# .codex/hooks/deliver_autoroute.py still returned a 600s heartbeat timeout
# after templates/ had moved to 1800, and every worktree created since showed
# the regenerated copies as uncommitted changes.
#
# templates/hooks/ is the source of truth and stays tracked (and shipped — it is
# in package.json "files"). .claude/hooks/ also stays tracked: it is this repo's
# own live configuration, dogfooded here, alongside .claude/settings.json.
#
# .factory/hooks/ is NOT in this list: it is the canonical store. Every other
# platform — including .claude — symlinks 9 of its hooks into it, and those
# symlinks are tracked. Untracking .factory left them dangling in a fresh
# checkout and broke 17 hook tests in CI. It also holds three hooks
# (pattern-rag-*, task_completion_hook) that exist nowhere else at all.
.codex/hooks/*
.cursor/hooks/*
.forge/hooks/*
.opencode/hooks/*

# Generated platform configs written by the same installer (.codex/config.toml
# is already ignored above for the same reason).
.cursor/hooks.json

# Plugin manifest written by the opencode setup step.
.opencode/package.json
