#!/usr/bin/env bash
# uap-sandbox — thin shim. The implementation now lives in the uap CLI; this just
# delegates to `uap sandbox` so there is a single source of truth. The env knobs
# (UAP_SANDBOX_WORKDIR, UAP_SANDBOX_ALLOW, UAP_SANDBOX_OFF=1) are read directly by
# `uap sandbox`.
#
# Usage: uap-sandbox <command> [args...]
set -euo pipefail

# UAP_SANDBOX_OFF=1 bypasses the sandbox entirely — run the command as-is, no
# dependency on the uap CLI.
if [[ "${UAP_SANDBOX_OFF:-}" == "1" ]]; then
  exec "$@"
fi

if ! command -v uap >/dev/null 2>&1; then
  echo "uap-sandbox: the 'uap' CLI is not on PATH — refusing to run unsandboxed." \
       "Install @miller-tech/uap (npm i -g @miller-tech/uap), or set UAP_SANDBOX_OFF=1 to bypass." >&2
  exit 127
fi

exec uap sandbox -- "$@"
